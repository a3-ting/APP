<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.course.CourseActivity"
            android:exported="false"
            android:label="@string/course_title" />

        <activity
            android:name=".ui.course.AddCourseActivity"
            android:exported="false"
            android:label="@string/add_course_title" />

        <activity
            android:name=".ui.course.CourseGridViewActivity"
            android:exported="false"
            android:label="@string/course_grid_view_title" />

        <activity
            android:name=".ui.course.CourseWeekViewActivity"
            android:exported="false"
            android:label="@string/course_week_view_title" />

        <activity
            android:name=".ui.course.CourseMonthViewActivity"
            android:exported="false"
            android:label="@string/course_month_view_title" />

        <activity
            android:name=".ui.course.CourseTimeSettingsActivity"
            android:exported="false"
            android:label="@string/course_time_settings_title" />

        <activity
            android:name=".ui.course.TeacherCourseActivity"
            android:exported="false"
            android:label="@string/teacher_course_title" />

        <activity
            android:name=".ui.assignment.AssignmentActivity"
            android:exported="false"
            android:label="@string/assignment_title" />

        <activity
            android:name=".ui.assignment.AddAssignmentActivity"
            android:exported="false"
            android:label="@string/add_assignment_title" />

        <activity
            android:name=".ui.grade.GradeActivity"
            android:exported="false"
            android:label="@string/grade_title" />

        <activity
            android:name=".ui.grade.TeacherGradeActivity"
            android:exported="false"
            android:label="@string/teacher_grade_title" />

        <activity
            android:name=".ui.study.StudyPlanActivity"
            android:exported="false"
            android:label="@string/study_plan_title" />

        <activity
            android:name=".ui.study.LearningProgressActivity"
            android:exported="false"
            android:label="@string/learning_progress_title" />

        <activity
            android:name=".ui.user.ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title" />

        <activity
            android:name=".ui.user.StudentManageActivity"
            android:exported="false"
            android:label="@string/student_manage_title" />

        <activity
            android:name=".ui.user.TeacherManageActivity"
            android:exported="false"
            android:label="@string/teacher_manage_title" />

        <activity
            android:name=".ui.user.UserManageActivity"
            android:exported="false"
            android:label="@string/user_manage_title" />

        <activity
            android:name=".ui.ai.AIChatActivity"
            android:exported="false"
            android:label="@string/ai_chat_title" />

        <activity
            android:name=".ui.reminder.ReminderActivity"
            android:exported="false"
            android:label="@string/reminder_title" />

        <activity
            android:name=".ui.notice.NoticeActivity"
            android:exported="false"
            android:label="@string/notice_title" />

        <activity
            android:name=".ui.settings.SystemSettingsActivity"
            android:exported="false"
            android:label="@string/system_settings_title" />

        <activity
            android:name=".ui.dialog.DialogActivity"
            android:exported="false"
            android:theme="@style/Theme.Dialog"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".service.ReminderService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.example.myapplication.COURSE_REMINDER" />
                <action android:name="com.example.myapplication.ASSIGNMENT_REMINDER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
